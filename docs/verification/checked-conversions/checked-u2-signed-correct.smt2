(set-logic QF_BV)
(set-option :produce-models true)
(set-option :timeout 5000)
(declare-fun input_0 () (_ BitVec 32))
(assert (let ((a!1 (bvand (bvnot (ite (bvslt input_0 #x00000000) #b1 #b0))
                  (ite (bvult input_0 #x00010000) #b1 #b0)))
      (a!2 (bvnot (bvor (ite (bvslt input_0 #x00000000) #b1 #b0)
                        (ite (bvslt #x0000ffff input_0) #b1 #b0)))))
  (not (= a!1 a!2))))

(check-sat)
