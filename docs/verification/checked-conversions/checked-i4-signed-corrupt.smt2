(set-logic QF_BV)
(set-option :produce-models true)
(set-option :timeout 5000)
(declare-fun input_0 () (_ BitVec 32))
(assert (let ((a!1 (bvnot (bvor (ite (bvslt input_0 #x80000000) #b1 #b0)
                        (ite (bvslt #x7fffffff input_0) #b1 #b0)))))
  (not (= #b1 (bvnot a!1)))))

(check-sat)
(get-model)
