{
  "name": "sharphdl-debug",
  "displayName": "SharpHDL Debug",
  "description": "Prototype hardware-clock debugging for SharpHDL localhost simulator",
  "version": "0.1.0",
  "publisher": "sharphdl",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onDebugResolve:sharphdl",
    "onCommand:sharphdl.verilatorLint"
  ],
  "main": "./extension.js",
  "contributes": {
    "debuggers": [
      {
        "type": "sharphdl",
        "label": "SharpHDL Hardware",
        "languages": [
          "csharp"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "csharp"
      }
    ],
    "configurationDefaults": {
      "launch": {
        "type": "sharphdl",
        "request": "launch",
        "name": "SharpHDL hardware (localhost)"
      }
    },
    "commands": [
      {
        "command": "sharphdl.verilatorLint",
        "title": "SharpHDL: Lint Active Verilog with Verilator"
      }
    ],
    "configuration": {
      "title": "SharpHDL",
      "properties": {
        "sharphdl.verilator.path": {
          "type": "string",
          "default": "verilator",
          "description": "Verilator executable path; must be installed on the VS Code extension host."
        },
        "sharphdl.verilator.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional Verilator arguments, passed without shell expansion."
        }
      }
    }
  }
}
