{
  "name": "sharphdl-debug",
  "displayName": "SharpHDL Hardware & Verification",
  "description": "Hardware clock debugger, Verilator lint, and TinyRisc verification Explorer",
  "version": "0.4.0",
  "publisher": "sharphdl",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers"
  ],
  "activationEvents": [
    "onDebugResolve:sharphdl",
    "onCommand:sharphdl.verilatorLint",
    "onView:sharphdl.verification",
    "onView:sharphdl.projects"
  ],
  "main": "./extension.js",
  "contributes": {
    "debuggers": [
      {
        "type": "sharphdl",
        "label": "SharpHDL Hardware",
        "languages": [
          "csharp"
        ]
      }
    ],
    "breakpoints": [
      {
        "language": "csharp"
      }
    ],
    "configurationDefaults": {
      "launch": {
        "type": "sharphdl",
        "request": "launch",
        "name": "SharpHDL hardware (localhost)"
      }
    },
    "commands": [
      {
        "command": "sharphdl.verilatorLint",
        "title": "SharpHDL: Lint Active Verilog with Verilator"
      },
      {
        "command": "sharphdl.verifyTinyRisc",
        "title": "SharpHDL: Run TinyRisc Verification"
      },
      {
        "command": "sharphdl.setupTools",
        "title": "SharpHDL: Set Up Toolchain"
      },
      {
        "command": "sharphdl.refreshVerification",
        "title": "SharpHDL: Refresh Verification Explorer"
      },
      {
        "command": "sharphdl.openVerificationFile",
        "title": "SharpHDL: Open Verification Artifact"
      },
      {
        "command": "sharphdl.buildDesign",
        "title": "SharpHDL: Build Verilator Design"
      },
      {
        "command": "sharphdl.runDesign",
        "title": "SharpHDL: Run Verilator Test"
      },
      {
        "command": "sharphdl.jumpToMapped",
        "title": "SharpHDL: Go to Source / Generated RTL"
      },
      {
        "command": "sharphdl.refreshProjects",
        "title": "SharpHDL: Refresh Projects"
      },
      {
        "command": "sharphdl.generateProvenance",
        "title": "SharpHDL: Generate HLS Source Map and RTL"
      },
      {
        "command": "sharphdl.showMappedSignals",
        "title": "SharpHDL: Find Mapped Waveform Signals"
      }
    ],
    "configuration": {
      "title": "SharpHDL",
      "properties": {
        "sharphdl.verilator.path": {
          "type": "string",
          "default": "verilator",
          "description": "Verilator executable path; must be installed on the VS Code extension host."
        },
        "sharphdl.verilator.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional Verilator arguments, passed without shell expansion."
        },
        "sharphdl.verilator.runner": {
          "type": "string",
          "enum": [
            "docker",
            "host"
          ],
          "default": "docker",
          "description": "Use SharpHDL's provisioned Docker image (default), or an installed host Verilator."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "sharphdl.verification",
          "name": "SharpHDL Verification",
          "contextualTitle": "SharpHDL Verification"
        },
        {
          "id": "sharphdl.projects",
          "name": "SharpHDL Projects",
          "contextualTitle": "SharpHDL Projects"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "sharphdl.refreshVerification",
          "when": "view == sharphdl.verification",
          "group": "navigation"
        },
        {
          "command": "sharphdl.refreshProjects",
          "when": "view == sharphdl.projects",
          "group": "navigation"
        }
      ]
    },
    "problemMatchers": [
      {
        "name": "sharphdlVerilator",
        "owner": "sharphdl",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^%(Error|Warning(?:-[A-Za-z0-9_-]+)?):\\\\s+(.+?):(\\\\d+):(\\\\d+):\\\\s*(.*)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "message": 5
        }
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffadickson/SharpHDL.git"
  }
}
