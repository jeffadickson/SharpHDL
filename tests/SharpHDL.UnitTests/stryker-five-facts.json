{
  "stryker-config": {
    "project": "SharpHDL.csproj",
    "additional-timeout": 15000,
    "reporters": [
      "json",
      "progress"
    ],
    "coverage-analysis": "off",
    "test-case-filter": "FullyQualifiedName~ScheduledNullRefinementTests|FullyQualifiedName~ScheduledMultipleRamTests|FullyQualifiedName~RamQualificationTests|FullyQualifiedName~RelationalAliasTests|FullyQualifiedName~PredicateMutationRegressionTests",
    "concurrency": 1,
    "mutate": [
      "**/ScheduledCilReferenceFacts.cs",
      "**/ScheduledCilRelations.cs"
    ]
  }
}
