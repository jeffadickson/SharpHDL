<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Reflection-driven CIL tests compile methods from this assembly.
               Instrumenting those bodies inserts unsupported collector calls and
               changes the program being tested. Measure production assemblies. -->
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <Exclude>[SharpHDL.UnitTests]SharpHDL.UnitTests.*,[SharpHDL.UnitTests]SharpHDL.Verification.*</Exclude>
          <Format>cobertura</Format>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
